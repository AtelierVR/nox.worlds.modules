<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements" editor="UnityEditor.UIElements">

    <Style src="project://database/Packages/nox.cck/Resources/nox.style.uss?fileID=7433441132597879392&amp;guid=956d93e835714844b98277f4fdbd77d3&amp;type=3#nox.style" />
    <Style src="project://database/Packages/nox.loader/Resources/nox.cck.style.uss?fileID=7433441132597879392&amp;guid=ee18ab989d89a1a479332bd224e51c94&amp;type=3#nox.cck.style" />

    <ui:VisualElement name="fields" class="flex-col my-8 gap-8">
        <uie:PropertyField name="prefab" />
        <uie:PropertyField name="label" />
        <uie:PropertyField name="icon" />
        <uie:PropertyField name="onMenuShown" />
        <uie:PropertyField name="onMenuHidden" />
    </ui:VisualElement>

    <!-- Same notification as the other nox inspectors: the element builds its own icon and message (see
         Nox.CCK.Editor.NotificationElement), so the box grows with its text. `kind` selects the
         .notification.warning variant; the editor swaps the lang-key with the case it hits. -->
    <uie:LocalizedNotificationElement name="warning" class="my-8 hidden" kind="Warning"
                                     lang-key="worlds.modules.custom_menu.inspector.warning_no_prefab" />

</ui:UXML>
