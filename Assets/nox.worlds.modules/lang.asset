    entries:
    - key: worlds.modules.custom_menu.inspector.title
      value: Custom Menu
    - key: worlds.modules.custom_menu.inspector.warning_not_ugui
      value: The page displays this prefab inside the menu, so a uGUI prefab (RectTransform) is expected.
    - key: worlds.modules.custom_menu.inspector.warning_no_prefab
      value: 'No menu prefab: the world does not provide a custom page, no button is added to the menu.'
    - key: worlds.modules.fell_in_void.inspector.title
      value: Fell In Void
    - key: worlds.modules.fell_in_void.inspector.threshold
      value: Fall threshold
    - key: worlds.modules.fell_in_void.inspector.player
      value: 'Local player position: {0}'
    - key: worlds.modules.fell_in_void.inspector.no_player
      value: 'No local player: the position is only known during a session.'
    - key: worlds.modules.scenes.inspector.title
      value: Scenes
    - key: worlds.modules.scenes.inspector.scene_assets
      value: Scene assets
    - key: worlds.modules.shader_variants.inspector.title
      value: Shader Variants
    - key: worlds.modules.shader_variants.inspector.collections
      value: Collections
    - key: worlds.modules.spawns.inspector.title
      value: Spawns
    - key: worlds.modules.spawns.inspector.spawn_type
      value: Spawn type
    - key: worlds.modules.spawns.inspector.spawn_index
      value: Spawn index
    - key: worlds.modules.spawns.inspector.spawns
      value: Spawn points
    - key: worlds.modules.spawns.inspector.none
      value: 'No spawn configured: the module spawns on its own transform.'
    - key: worlds.modules.spawns.inspector.remove
      value: Remove this spawn
    - key: worlds.modules.spawns.inspector.no_type
      value: 'No serializable spawn type in the project'
    - key: worlds.modules.notification.duplicated
      value: '{0} modules found ({1}): the world check expects exactly one and fails with more, which blocks the build.'
    - key: worlds.modules.notification.action.add
      value: Add the module
    - key: worlds.modules.fell_in_void.missing
      value: 'No {0} module on the world: it respawns a player who falls below its threshold (default {1}), and the spawns of the world are checked against that threshold.'
    - key: worlds.modules.spawn.missing
      value: 'No {0} module on the world: it places the players when the world loads; without it they spawn on the WorldDescriptor, and the world check adds it anyway.'
    - key: worlds.modules.scenes.module_missing
      value: 'No {0} module on the world: it lists the extra scenes loaded with the world, and the world check adds it anyway.'
    - key: worlds.modules.shader_variants.missing
      value: 'No {0} module on the world: it warms the collections up when the world loads, which avoids shader compilation hitches, and the world check adds it anyway.'
    - key: worlds.modules.spawn.below_threshold
      value: '{0} spawn(s) are under the fall threshold ({1}): players are respawned as soon as they spawn.'
    - key: worlds.modules.spawn.none
      value: 'No spawn configured: players spawn on the WorldDescriptor by default.'
    - key: worlds.modules.custom_menu.not_ugui
      value: '{0} custom menu prefab(s) are not uGUI prefabs (a RectTransform is expected): the page stays empty.'
    - key: worlds.modules.custom_menu.no_prefab
      value: 'The custom menu module has no prefab: no page is added to the player menu.'
    - key: worlds.modules.scenes.missing
      value: '{0} scene asset(s) of the scenes module are missing from the project.'
    - key: worlds.modules.shader_variants.none
      value: 'No shader variant collection: nothing is warmed up when the world loads.'
    - key: worlds.modules.notification.action.select
      value: Select
  - IETF: fr-FR
    entries:
    - key: worlds.modules.custom_menu.inspector.title
      value: Menu personnalisé
    - key: worlds.modules.custom_menu.inspector.warning_not_ugui
      value: "La page affiche ce prefab dans le menu : un prefab uGUI (RectTransform) est attendu."
